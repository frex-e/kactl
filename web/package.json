{
  "name": "kactl-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "copy-pdf": "test -f ../kactl.pdf && mkdir -p public && cp ../kactl.pdf public/kactl.pdf || true",
    "predev": "make -C .. preprocess && npm run copy-pdf",
    "dev": "vite",
    "prebuild": "make -C .. preprocess && npm run copy-pdf",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "node scripts/test-latex.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "minisearch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
